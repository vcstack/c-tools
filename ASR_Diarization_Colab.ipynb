    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "setup_project"
      },
      "outputs": [],
      "source": [
        "from pathlib import Path\n",
        "import shutil\n",
        "import textwrap\n",
        "\n",
        "ROOT = Path(\"/content/asr_json\")\n",
        "if ROOT.exists():\n",
        "    shutil.rmtree(ROOT)\n",
        "ROOT.mkdir(parents=True)\n",
        "(ROOT / \"input\").mkdir()\n",
        "(ROOT / \"output\").mkdir()\n",
        "(ROOT / \"pipeline\").mkdir()\n",
        "(ROOT / \"sonitr_st\").mkdir()\n",
        "\n",
        "!git clone --depth 1 https://github.com/R3gm/SoniTranslate.git /content/asr_json/SoniTranslate\n",
        "\n",
        "src = Path(\"/content/asr_json/SoniTranslate/soni_translate/speech_segmentation.py\").read_text(encoding=\"utf-8\")\n",
        "src = src.replace(\"from IPython.utils import capture # noqa\\n\", \"\")\n",
        "src = src.replace(\n",
        "    \"from .language_configuration import EXTRA_ALIGN, INVERTED_LANGUAGES\",\n",
        "    \"from .align_languages import EXTRA_ALIGN, INVERTED_LANGUAGES\",\n",
        ")\n",
        "src = src.replace(\n",
        "    \"from .postprocessor import sanitize_file_name\\nfrom .utils import remove_directory_contents, run_command\",\n",
        "    \"from .media_utils import remove_directory_contents, run_command, sanitize_file_name\",\n",
        ")\n",
        "src = src.replace(\n",
        "    'f\"No speaker detected in {segment[\\'start\\\']}. First TTS \"\\n                    f\"will be used for the segment text: {segment[\\'text\\\']} \"',\n",
        "    'f\"No speaker detected at {segment[\\'start\\\']}; defaulting to SPEAKER_00\"',\n",
        ")\n",
        "(ROOT / \"sonitr_st\" / \"speech_segmentation.py\").write_text(src, encoding=\"utf-8\")\n",
        "shutil.copy(\n",
        "    ROOT / \"SoniTranslate\" / \"soni_translate\" / \"logging_setup.py\",\n",
        "    ROOT / \"sonitr_st\" / \"logging_setup.py\",\n",
        ")\n",
        "\n",
        "files = {}\n",
        "files[\"sonitr_st/__init__.py\"] = \"\"\n",
        "files[\"pipeline/__init__.py\"] = \"\"\n",
        "files[\"sonitr_st/align_languages.py\"] = textwrap.dedent('''\n",
        "    from pathlib import Path\n",
        "    import sys\n",
        "    _ROOT = Path(__file__).resolve().parents[1]\n",
        "    _SONITR_ROOT = _ROOT / \"SoniTranslate\"\n",
        "    if _SONITR_ROOT.is_dir():\n",
        "        p = str(_SONITR_ROOT)\n",
        "        if p not in sys.path:\n",
        "            sys.path.insert(0, p)\n",
        "        from soni_translate.language_configuration import EXTRA_ALIGN, INVERTED_LANGUAGES\n",
        "    else:\n",
        "        EXTRA_ALIGN = {}\n",
        "        INVERTED_LANGUAGES = {}\n",
        "''')\n",
        "files[\"sonitr_st/media_utils.py\"] = textwrap.dedent('''\n",
        "    import os, re, shutil, subprocess, sys, unicodedata, shlex\n",
        "    from .logging_setup import logger\n",
        "\n",
        "    def run_command(command):\n",
        "        if isinstance(command, str):\n",
        "            command = shlex.split(command)\n",
        "        proc = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE)\n",
        "        _out, errors = proc.communicate()\n",
        "        if proc.returncode != 0:\n",
        "            raise RuntimeError(errors.decode(errors=\"replace\"))\n",
        "\n",
        "    def sanitize_file_name(file_name):\n",
        "        return re.sub(r\"[^\\w\\s.-]\", \"_\", unicodedata.normalize(\"NFKD\", file_name))\n",
        "\n",
        "    def remove_directory_contents(directory_path):\n",
        "        if not os.path.exists(directory_path):\n",
        "            return\n",
        "        for name in os.listdir(directory_path):\n",
        "            p = os.path.join(directory_path, name)\n",
        "            if os.path.isfile(p):\n",
        "                os.remove(p)\n",
        "            elif os.path.isdir(p):\n",
        "                shutil.rmtree(p)\n",
        "''')\n",
        "\n",
        "for rel, content in files.items():\n",
        "    path = ROOT / rel\n",
        "    path.parent.mkdir(parents=True, exist_ok=True)\n",
        "    path.write_text(content.lstrip(\"\\n\"), encoding=\"utf-8\")\n",
        "\n",
        "print(\"Project:\", ROOT)\n",
        "print(\"SoniTranslate cloned:\", (ROOT / \"SoniTranslate\").is_dir())"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "write_pipeline"
      },
      "outputs": [],
      "source": [
        "from pathlib import Path\n",
        "ROOT = Path(\"/content/asr_json\")\n",
        "\n",
        "(ROOT / \"pipeline\" / \"config.py\").write_text(r'''\n",
        "from __future__ import annotations\n",
        "import os\n",
        "from dataclasses import dataclass\n",
        "import torch\n",
        "from dotenv import load_dotenv\n",
        "load_dotenv()\n",
        "\n",
        "@dataclass\n",
        "class PipelineConfig:\n",
        "    asr_model: str = \"large-v3\"\n",
        "    compute_type: str = \"default\"\n",
        "    batch_size: int = 8\n",
        "    segment_duration_limit: int = 15\n",
        "    source_language: str | None = None\n",
        "    literalize_numbers: bool = True\n",
        "    min_speakers: int = 1\n",
        "    max_speakers: int = 10\n",
        "    diarization_model_key: str = \"pyannote_3.1\"\n",
        "    device: str = \"cpu\"\n",
        "    hf_token: str | None = None\n",
        "    work_dir: str = \".cache/pipeline\"\n",
        "\n",
        "def resolve_device(device: str | None = None) -> str:\n",
        "    if device and device != \"auto\":\n",
        "        chosen = device\n",
        "    elif torch.cuda.is_available():\n",
        "        chosen = \"cuda\"\n",
        "    else:\n",
        "        chosen = \"cpu\"\n",
        "    os.environ[\"SONITR_DEVICE\"] = chosen\n",
        "    return chosen\n",
        "\n",
        "def resolve_hf_token() -> str | None:\n",
        "    token = os.environ.get(\"HF_TOKEN\") or os.environ.get(\"HUGGING_FACE_HUB_TOKEN\")\n",
        "    return token.strip() if token else None\n",
        "\n",
        "def resolve_compute_type(device: str, compute_type: str) -> str:\n",
        "    if compute_type != \"default\":\n",
        "        return compute_type\n",
        "    return \"float16\" if device == \"cuda\" else \"int8\"\n",
        "'''.lstrip(), encoding=\"utf-8\")\n",
        "\n",
        "(ROOT / \"pipeline\" / \"audio.py\").write_text(r'''\n",
        "from __future__ import annotations\n",
        "import json, shlex, subprocess, sys\n",
        "from pathlib import Path\n",
        "import soundfile as sf\n",
        "from sonitr_st.media_utils import run_command\n",
        "\n",
        "VIDEO_EXTENSIONS = {\".mp4\", \".mkv\", \".mov\", \".avi\", \".webm\", \".m4v\", \".mpeg\", \".mpg\", \".wmv\", \".flv\"}\n",
        "AUDIO_EXTENSIONS = {\".mp3\", \".wav\", \".m4a\", \".aac\", \".ogg\", \".flac\", \".opus\", \".wma\", \".aiff\", \".aif\"}\n",
        "\n",
        "def is_audio(path):\n",
        "    return Path(path).suffix.lower() in AUDIO_EXTENSIONS\n",
        "\n",
        "def validate_input(path):\n",
        "    p = Path(path).resolve()\n",
        "    if not p.is_file():\n",
        "        raise FileNotFoundError(f\"Input file not found: {p}\")\n",
        "    ext = p.suffix.lower()\n",
        "    if ext not in VIDEO_EXTENSIONS | AUDIO_EXTENSIONS:\n",
        "        raise ValueError(f\"Unsupported extension {ext}\")\n",
        "    return p\n",
        "\n",
        "def get_duration_seconds(audio_path):\n",
        "    return float(sf.info(str(audio_path)).duration)\n",
        "\n",
        "def extract_audio(input_path, output_wav):\n",
        "    input_path, output_wav = Path(input_path), Path(output_wav)\n",
        "    output_wav.parent.mkdir(parents=True, exist_ok=True)\n",
        "    extra = \"\" if is_audio(input_path) and input_path.suffix.lower() == \".wav\" else \"-vn\"\n",
        "    run_command(f'ffmpeg -y -i \"{input_path}\" {extra} -acodec pcm_s16le -ar 44100 -ac 2 \"{output_wav}\"')\n",
        "    if not output_wav.is_file() or output_wav.stat().st_size == 0:\n",
        "        raise RuntimeError(f\"FFmpeg did not produce audio: {output_wav}\")\n",
        "    return output_wav\n",
        "\n",
        "def probe_duration_ffprobe(media_path):\n",
        "    cmd = shlex.split(f'ffprobe -v error -show_entries format=duration -of json \"{media_path}\"')\n",
        "    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)\n",
        "    out, _ = proc.communicate()\n",
        "    if proc.returncode != 0:\n",
        "        return None\n",
        "    try:\n",
        "        return float(json.loads(out.decode(\"utf-8\"))[\"format\"][\"duration\"])\n",
        "    except Exception:\n",
        "        return None\n",
        "'''.lstrip(), encoding=\"utf-8\")\n",
        "\n",
        "(ROOT / \"pipeline\" / \"transcription.py\").write_text(r'''\n",
        "from __future__ import annotations\n",
        "from sonitr_st.logging_setup import configure_logging_libs, logger\n",
        "from sonitr_st.speech_segmentation import align_speech, transcribe_speech\n",
        "configure_logging_libs()\n",
        "\n",
        "def run_transcription(audio_wav, *, asr_model, compute_type, batch_size, source_language, literalize_numbers, segment_duration_limit, align=True):\n",
        "    audio, result = transcribe_speech(audio_wav, asr_model, compute_type, batch_size, source_language, literalize_numbers, segment_duration_limit)\n",
        "    if not result.get(\"segments\"):\n",
        "        raise ValueError(\"No speech detected in the audio.\")\n",
        "    if align:\n",
        "        try:\n",
        "            result = align_speech(audio, result)\n",
        "        except Exception as exc:\n",
        "            logger.warning(f\"Alignment skipped/failed: {exc}\")\n",
        "    return audio, result\n",
        "'''.lstrip(), encoding=\"utf-8\")\n",
        "\n",
        "(ROOT / \"pipeline\" / \"diarization.py\").write_text(r'''\n",
        "from __future__ import annotations\n",
        "from sonitr_st.speech_segmentation import diarization_models, diarize_speech\n",
        "\n",
        "def run_diarization(audio_wav, asr_result, *, hf_token, min_speakers, max_speakers, model_key=\"pyannote_3.1\"):\n",
        "    model_name = diarization_models.get(model_key, diarization_models[\"pyannote_3.1\"])\n",
        "    if model_key != \"disable\" and max(min_speakers, max_speakers) > 1 and not hf_token:\n",
        "        raise ValueError(\"HF_TOKEN is required for pyannote. Set token below or use max_speakers=1.\")\n",
        "    return diarize_speech(audio_wav, asr_result, min_speakers, max_speakers, hf_token or \"\", model_name)\n",
        "'''.lstrip(), encoding=\"utf-8\")\n",
        "\n",
        "(ROOT / \"pipeline\" / \"alignment.py\").write_text(r'''\n",
        "from __future__ import annotations\n",
        "\n",
        "def _word_text(word):\n",
        "    return word.get(\"word\") or word.get(\"text\") or \"\"\n",
        "\n",
        "def _words_to_segment(speaker, words):\n",
        "    text = \"\".join(_word_text(w) for w in words).strip()\n",
        "    if not text:\n",
        "        text = \" \".join(_word_text(w).strip() for w in words if _word_text(w)).strip()\n",
        "    return {\"speaker\": speaker, \"start\": float(words[0][\"start\"]), \"end\": float(words[-1][\"end\"]), \"text\": text}\n",
        "\n",
        "def _split_segment_by_word_speakers(segment):\n",
        "    words = segment.get(\"words\") or []\n",
        "    usable = [w for w in words if w.get(\"speaker\") and w.get(\"start\") is not None and w.get(\"end\") is not None]\n",
        "    if not usable:\n",
        "        return [{\n",
        "            \"speaker\": segment.get(\"speaker\", \"SPEAKER_00\"),\n",
        "            \"start\": float(segment[\"start\"]),\n",
        "            \"end\": float(segment[\"end\"]),\n",
        "            \"text\": (segment.get(\"text\") or \"\").strip(),\n",
        "        }]\n",
        "    chunks, current_speaker, current_words = [], usable[0][\"speaker\"], [usable[0]]\n",
        "    for word in usable[1:]:\n",
        "        if word[\"speaker\"] == current_speaker:\n",
        "            current_words.append(word)\n",
        "        else:\n",
        "            chunks.append(_words_to_segment(current_speaker, current_words))\n",
        "            current_speaker, current_words = word[\"speaker\"], [word]\n",
        "    chunks.append(_words_to_segment(current_speaker, current_words))\n",
        "    return [c for c in chunks if c[\"text\"]]\n",
        "\n",
        "def build_output_segments(result_diarize):\n",
        "    out = []\n",
        "    for segment in result_diarize.get(\"segments\", []):\n",
        "        out.extend(_split_segment_by_word_speakers(segment))\n",
        "    out.sort(key=lambda s: (s[\"start\"], s[\"end\"]))\n",
        "    return out\n",
        "\n",
        "def build_json_payload(*, filename, duration, result_diarize):\n",
        "    segments = build_output_segments(result_diarize)\n",
        "    return {\n",
        "        \"source\": {\"filename\": filename, \"duration\": round(float(duration or 0), 3)},\n",
        "        \"speakers\": sorted({s[\"speaker\"] for s in segments}),\n",
        "        \"segments\": segments,\n",
        "    }\n",
        "'''.lstrip(), encoding=\"utf-8\")\n",
        "\n",
        "(ROOT / \"pipeline\" / \"pipeline.py\").write_text(r'''\n",
        "from __future__ import annotations\n",
        "import json\n",
        "from pathlib import Path\n",
        "from sonitr_st.logging_setup import logger\n",
        "from .alignment import build_json_payload\n",
        "from .audio import extract_audio, get_duration_seconds, probe_duration_ffprobe, validate_input\n",
        "from .config import PipelineConfig, resolve_compute_type, resolve_device, resolve_hf_token\n",
        "from .diarization import run_diarization\n",
        "from .transcription import run_transcription\n",
        "\n",
        "def run_pipeline(input_path, output_path, config: PipelineConfig) -> dict:\n",
        "    input_path = validate_input(input_path)\n",
        "    output_path = Path(output_path)\n",
        "    output_path.parent.mkdir(parents=True, exist_ok=True)\n",
        "    work_dir = Path(config.work_dir)\n",
        "    work_dir.mkdir(parents=True, exist_ok=True)\n",
        "    wav_path = work_dir / \"extracted.wav\"\n",
        "    device = resolve_device(config.device)\n",
        "    compute_type = resolve_compute_type(device, config.compute_type)\n",
        "    hf_token = config.hf_token if config.hf_token is not None else resolve_hf_token()\n",
        "\n",
        "    print(\"[1/5] Loading input...\")\n",
        "    duration = probe_duration_ffprobe(input_path)\n",
        "    print(\"[2/5] Extracting audio...\")\n",
        "    extract_audio(input_path, wav_path)\n",
        "    if duration is None:\n",
        "        duration = get_duration_seconds(wav_path)\n",
        "    print(\"[3/5] Running speech recognition...\")\n",
        "    logger.info(f\"Device: {device}, ASR model: {config.asr_model}, compute: {compute_type}\")\n",
        "    _audio, asr_result = run_transcription(\n",
        "        str(wav_path),\n",
        "        asr_model=config.asr_model,\n",
        "        compute_type=compute_type,\n",
        "        batch_size=config.batch_size,\n",
        "        source_language=config.source_language,\n",
        "        literalize_numbers=config.literalize_numbers,\n",
        "        segment_duration_limit=config.segment_duration_limit,\n",
        "    )\n",
        "    print(\"[4/5] Running speaker diarization...\")\n",
        "    diarized = run_diarization(\n",
        "        str(wav_path), asr_result, hf_token=hf_token,\n",
        "        min_speakers=config.min_speakers, max_speakers=config.max_speakers,\n",
        "        model_key=config.diarization_model_key,\n",
        "    )\n",
        "    print(\"[5/5] Merging transcript and speakers...\")\n",
        "    payload = build_json_payload(filename=input_path.name, duration=duration, result_diarize=diarized)\n",
        "    output_path.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n",
        "    print(f\"[OK] JSON written to {output_path}\")\n",
        "    return payload\n",
        "'''.lstrip(), encoding=\"utf-8\")\n",
        "\n",
        "print(\"Wrote pipeline modules\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "token_md"
      },
      "source": [
        "## 3. Hugging Face token\n",
        "\n",
        "Bắt buộc nếu muốn tách nhiều speaker (`max_speakers > 1`).  \n",
        "Nếu để trống và `max_speakers=1` thì mọi câu sẽ gán `SPEAKER_00`."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "hf_token",
        "cellView": "form"
      },
      "outputs": [],
      "source": [
        "# @title Hugging Face token\n",
        "HF_TOKEN = \"\"  # @param {type:\"string\"}\n",
        "import os\n",
        "from pathlib import Path\n",
        "os.environ[\"HF_TOKEN\"] = HF_TOKEN.strip()\n",
        "os.environ[\"HUGGING_FACE_HUB_TOKEN\"] = HF_TOKEN.strip()\n",
        "(Path(\"/content/asr_json\") / \".env\").write_text(f\"HF_TOKEN={HF_TOKEN.strip()}\\n\", encoding=\"utf-8\")\n",
        "print(\"HF_TOKEN set:\" , bool(HF_TOKEN.strip()))"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "input_md"
      },
      "source": [
        "## 4. Chọn input\n",
        "\n",
        "Chạy **một** trong hai cell: upload file của bạn, hoặc tải mẫu JFK (tiếng Anh, 1 speaker)."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "upload_file"
      },
      "outputs": [],
      "source": [
        "from google.colab import files\n",
        "from pathlib import Path\n",
        "import shutil\n",
        "\n",
        "INPUT_DIR = Path(\"/content/asr_json/input\")\n",
        "INPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "uploaded = files.upload()\n",
        "if not uploaded:\n",
